GOOGLE_API_KEY=your_gemini_api_key_here
# Shared secret for trusted-mode endpoints (/v1/chat, /v1/text).
# Use a long random value (e.g. `openssl rand -hex 16`) — its SHA-256 is served
# publicly by /health, so a short/guessable key can be brute-forced offline.
# Leave blank to disable trusted mode entirely (BYOK-only).
ACCESS_KEY=your_shared_access_key_here
# Set to 1 to also require ACCESS_KEY on /v1/stt and /v1/tts. Off by default:
# BYOK clients call those endpoints without credentials.
REQUIRE_AUTH_STT_TTS=0
PORT=8000
HOST=0.0.0.0
# Device for Whisper inference: "cpu" (default) or "cuda" (requires NVIDIA GPU)
DEVICE=cpu
# Max seconds for ffmpeg transcode / mp3 encode (raise on slow CPUs)
FFMPEG_TIMEOUT=30
