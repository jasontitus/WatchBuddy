GOOGLE_API_KEY=your_gemini_api_key_here
# Shared secret for trusted-mode endpoints (/v1/chat, /v1/text).
# Leave blank to disable trusted mode entirely (BYOK-only).
ACCESS_KEY=your_shared_access_key_here
PORT=8000
HOST=0.0.0.0
# Device for Whisper inference: "cpu" (default) or "cuda" (requires NVIDIA GPU)
DEVICE=cpu
# Max seconds for ffmpeg transcode / mp3 encode (raise on slow CPUs)
FFMPEG_TIMEOUT=30
